# Copy these into the Vercel project settings (Settings > Environment Variables). Never commit real values.

# Hosted Postgres connection string (Neon, Supabase, Vercel Postgres, ...). Use the pooled URL on serverless.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Keep the pool small on serverless: every function instance opens its own connections.
DB_POOL_MAX=3
# Set to false if your pooler runs in transaction mode and rejects prepared statements.
DB_PREPARE=true

# Trust the proxy-supplied client address for rate limits. Correct on Vercel, wrong anywhere the API is directly reachable.
TRUST_PROXY=true
# "dev" shows verification, reset and invitation emails in an in-app mailbox because no email provider is connected.
EMAIL_MODE=dev

# Deployed StarPay payment contract on Arc Testnet and the block it was deployed at.
VITE_PAYMENT_ROUTER_ADDRESS=
VITE_PAYMENT_ROUTER_DEPLOY_BLOCK=
# Optional: your own Arc Testnet RPC URL.
RPC_URL_Arc_Testnet=

# Optional: any OpenAI-compatible provider for the AI assistant.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Secret for the daily scheduled job at /api/cron (Vercel sends it as a Bearer token). Use a long random string.
CRON_SECRET=

VITE_SUPABASE_URL=https://fepztwbeyilgxidszysk.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
